<service>
  <id>ManAndMachineADMSBridge</id>
  <name>Man and Machine ADMS Bridge</name>
  <description>Local Windows 11 ADMS Bridge forwarding eSSL X2008 biometric events to Man and Machine Render HTTPS backend.</description>
  <executable>node</executable>
  <arguments>src\server.js</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\..\logs\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <stoptimeout>15 sec</stoptimeout>
</service>
