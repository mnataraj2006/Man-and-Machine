# Local HTTP listener for eSSL X2008 ADMS traffic
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8081

# Render cloud backend base URL (HTTPS required in production — replace with your actual Render URL)
RENDER_BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Must match ADMS_SHARED_SECRET configured on Render
BRIDGE_SHARED_SECRET=replace-with-strong-shared-secret

# Comma-separated list of authorized eSSL device serial numbers
ALLOWED_DEVICE_SERIALS=TDDB250600919

# Comma-separated list of allowed local LAN IPv4/IPv6 addresses for X2008
# Leave empty only if you rely strictly on local firewall rules
ALLOWED_DEVICE_IPS=192.168.0.203,127.0.0.1

# Local SQLite database path for durable outbox queue
SQLITE_DB_PATH=./data/bridge.sqlite

# Cloud forwarding & retry worker tuning
CLOUD_REQUEST_TIMEOUT_MS=10000
RETRY_POLL_INTERVAL_MS=5000
RETRY_BASE_DELAY_MS=5000
RETRY_MAX_DELAY_MS=300000
MAX_RETRY_ATTEMPTS=25
BATCH_FLUSH_LIMIT=20

# Local administrative health endpoint (bind to localhost only by default)
HEALTH_BIND_LOCAL_ONLY=true

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
