MONGODB_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional SMTP Email Delivery Configuration (for Trainer Invitations & Password Resets)
# If omitted, the Admin portal provides secure manual one-time invitation links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@manandmachine.com

# Official WhatsApp Cloud API (server-side only; never expose as VITE_* variables)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
